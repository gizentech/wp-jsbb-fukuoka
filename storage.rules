rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ファイル管理用のパス
    match /files/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // コンテンツ画像用のパス
    match /contents/{allPaths=**} {
      allow read: if true;  // 誰でも読み取り可能
      allow write: if request.auth != null;
    }
    
    // その他全てのパス（デフォルトルール）
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}